{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hopepitomev2",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./out"
  },
  "observability": {
    "enabled": true
  }
}
