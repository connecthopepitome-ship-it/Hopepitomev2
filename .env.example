# =============================================================================
# HOPEPITOME V2 — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy values into .env.local (Next.js build) and Cloudflare Worker Secrets.
# Never commit actual production secrets.
# =============================================================================

# Firebase Client Configuration (Public Web SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Application Site Metadata
NEXT_PUBLIC_SITE_URL=https://hopepitomev2.connect-hopepitome.workers.dev
NEXT_PUBLIC_SITE_NAME=Hopepitome Career Services

# Google Apps Script Drive & Notification Bridge (Worker Secrets)
GAS_WEB_APP_URL=https://script.google.com/macros/s/your_deployment_id/exec
GAS_SHARED_SECRET=replace_with_gas_shared_secret
ROOT_FOLDER_ID=replace_with_drive_root_folder_id

# AI / Admin Settings (Worker Secrets)
ADMIN_EMAILS=admin@hopepitome.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
OPENAI_API_KEY=replace_with_openai_api_key

# AI Job Match Feature Flag (Default OFF until explicitly enabled)
FEATURE_JOB_MATCH=false
NEXT_PUBLIC_FEATURE_JOB_MATCH=false

# AI Job Match Google Apps Script Import API Secret (Worker Secret ONLY — never NEXT_PUBLIC_)
JOB_MATCH_API_KEY=replace_with_high_entropy_bearer_secret

