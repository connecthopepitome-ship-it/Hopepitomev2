rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role in [
          'super_admin', 'admin', 'consultant', 'writer',
          'job_search_exec', 'portfolio_dev', 'finance',
          'Super Admin', 'Admin', 'Career Consultant', 'Resume Writer',
          'Job Search Executive', 'Portfolio Developer', 'Finance', 'Read-only Manager'
        ] ||
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'connect.hopepitome@gmail.com',
          'admin@hopepitome.com',
          'ramsaltvc@gmail.com'
        ]
      );
    }

    // =========================================================================
    // PHASE 5 & 12: EXACT COLLECTIONS (Deny-by-default)
    // =========================================================================

    // 1. Clients
    match /clients/{clientId} {
      allow read: if isOwner(clientId) || isStaff();
      // Client creation is handled by Cloudflare Worker API; client can update their basic record
      allow update: if isOwner(clientId) || isStaff();
      allow create, delete: if isStaff();
    }

    // 2. Work Orders (HP-YYYY-XXXXX)
    match /workOrders/{workOrderId} {
      allow read: if isStaff() || (isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        request.auth.token.workOrderId == workOrderId
      ));
      // Only staff can update work order status or assignment; client cannot alter status
      allow create, update, delete: if isStaff();
    }

    // 3. Career Profiles
    match /careerProfiles/{clientId} {
      allow read, write: if isOwner(clientId) || isStaff();
    }

    // 4. Documents Vault (Metadata)
    match /documents/{documentId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
    }

    // 5. Service Orders
    match /serviceOrders/{serviceOrderId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // 6. Messages
    match /messages/{messageId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // 7. Activity Logs (Audit trail)
    match /activityLogs/{activityId} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Append-only audit trail
    }

    // 8. Admins (RBAC control)
    match /admins/{adminId} {
      allow read, write: if isStaff();
    }

    // =========================================================================
    // BACKWARD COMPATIBILITY ALIASES
    // =========================================================================

    match /career_users/{userId} {
      allow read, write: if isOwner(userId) || isStaff();
    }
    match /career_clients/{clientId} {
      allow read, write: if isOwner(clientId) || isStaff();
    }
    match /career_profiles/{clientId} {
      allow read, write: if isOwner(clientId) || isStaff();
    }
    match /career_service_orders/{orderId} {
      allow read: if isOwner(resource.data.clientId) || isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || isOwner(resource.data.clientId);
    }
    match /career_tasks/{taskId} {
      allow read, write: if isStaff();
    }
    match /career_deliverables/{deliverableId} {
      allow read: if isOwner(resource.data.clientId) || isStaff();
      allow create, update, delete: if isStaff() || isOwner(resource.data.clientId);
    }
    match /career_revisions/{revId} {
      allow read: if isOwner(resource.data.clientId) || isStaff();
      allow create, update: if isAuthenticated();
      allow delete: if isStaff();
    }
    match /career_messages/{messageId} {
      allow read: if isOwner(resource.data.clientId) || isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }
    match /career_documents/{documentId} {
      allow read: if isOwner(resource.data.clientId) || isStaff();
      allow create, update, delete: if isOwner(resource.data.clientId) || isStaff();
    }
    match /career_invoices/{invoiceId} {
      allow read: if isOwner(resource.data.clientId) || isStaff();
      allow write: if isStaff();
    }
    match /career_activity_logs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
